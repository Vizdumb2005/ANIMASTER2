{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "types": ["node"],
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "baseUrl": "..",
    "paths": {
      "@animaster/shared/*": ["shared/src/*"],
      "@animaster/client/*": ["client/src/*"],
      "@animaster/server/*": ["server/src/*"]
    }
  },
  "include": ["src", "../shared/src"]
}