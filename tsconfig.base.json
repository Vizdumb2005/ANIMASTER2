{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "ignoreDeprecations": "5.0",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@animaster/shared/*": ["shared/src/*"],
      "@animaster/client/*": ["client/src/*"],
      "@animaster/server/*": ["server/src/*"]
    }
  }
}